# Copy this file to .env and fill in real values. Never commit the real .env.

# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
#
# On Vercel (or any serverless host) with a pooled provider like Supabase, use
# the transaction-mode pooler port (6543), not the session-mode port (5432).
# Each serverless invocation opens its own connection; session mode holds it
# open and exhausts the pool's connection slots under concurrency, which shows
# up as slow or hanging page loads. Also keep the deployment region pinned
# (see vercel.json) next to the database region to avoid cross-region latency
# on every query.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mess_calculator_next"

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Auth.js refuses unrecognised Host headers in production unless told the app is
# behind a trusted proxy. Required for `npm start` and for any self-hosted
# deploy; set it on the host too, not just here.
AUTH_TRUST_HOST=true

# Used for "today" and month boundaries, mirroring Django's TIME_ZONE.
APP_TIME_ZONE="Asia/Dhaka"
